# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
P10_ENV=development
P10_DB_PATH=backend/data/app.db
P10_MODEL_DIR=backend/data/models
P10_REDIS_URL=
P10_CACHE_TTL_SECONDS=900
P10_MAX_UPLOAD_ROWS=100000
P10_MIN_TRAINING_ROWS=120
P10_DEFAULT_HORIZON=30
P10_MAX_HORIZON=90
P10_CORS_ORIGINS=*

# Demo tenants (disable in production)
P10_DEMO_MODE=true
P10_DEMO_KEY_A=p10-demo-tenant-a
P10_DEMO_KEY_B=p10-demo-tenant-b

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
P10_API_URL=http://localhost:8000/api/v1
